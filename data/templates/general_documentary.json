{
  "name": "General Documentary",
  "description": "Flexible documentary template with standard pacing",
  "target_duration": 120,
  "aspect_ratio": "16:9",
  "resolution": {
    "width": 1920,
    "height": 1080
  },
  "fps": 30,
  "acts": [
    {
      "name": "Opening",
      "description": "Set the scene",
      "duration_pct": 0.1,
      "micro_cuts": false,
      "style": "cinematic"
    },
    {
      "name": "Introduction",
      "description": "Introduce subjects and themes",
      "duration_pct": 0.2,
      "micro_cuts": false,
      "style": "conversational"
    },
    {
      "name": "Development",
      "description": "Develop the narrative",
      "duration_pct": 0.3,
      "micro_cuts": true,
      "micro_cut_interval": 2.0,
      "style": "engaging"
    },
    {
      "name": "Climax",
      "description": "The peak moment",
      "duration_pct": 0.2,
      "micro_cuts": true,
      "micro_cut_interval": 1.5,
      "style": "intense"
    },
    {
      "name": "Resolution",
      "description": "Wrap up and closing thoughts",
      "duration_pct": 0.2,
      "micro_cuts": false,
      "style": "reflective"
    }
  ]
}